# Proxmox Backup Orchestrator production environment example.
# Copy to .env on the app VM and fill in real values. Never commit .env.
# Generate random tokens/secrets with: openssl rand -hex 32
# Do not use code_secret.
#
# Docker Compose .env warning:
# bcrypt hashes contain "$". In Compose env files every "$" must be escaped as "$$".
# Example: AUTH_PASSWORD_HASH=$$2b$$12$$...

# -----------------------------------------------------------------------------
# App VM: bootstrap values (always read from the environment)
# -----------------------------------------------------------------------------
# Defaults to production. Demo data is only created with DEV_SEED=true.
APP_ENV=production
DEV_SEED=false
# Host port published by Compose. The API also serves the web UI (same origin).
API_PORT=8000

POSTGRES_DB=proxmox_backup_orchestrator
POSTGRES_USER=pbo
POSTGRES_PASSWORD=replace-with-random-postgres-password
DATABASE_URL=postgresql+psycopg://pbo:replace-with-random-postgres-password@db:5432/proxmox_backup_orchestrator

# Signs session cookies AND derives the key encrypting secrets stored in the
# database (API tokens, ntfy password). Changing it logs everyone out and makes
# stored secrets unreadable (they must be re-entered). Generate with:
# openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-random-secret-key
# The session cookie is `Secure`: browsers only keep it over HTTPS (or on
# http://localhost). Set to false ONLY for plain-HTTP access on a trusted LAN.
AUTH_COOKIE_SECURE=true
# Built UI location; empty = auto-detect (apps/web/dist or the image's web-dist).
# WEB_DIST_DIR=

PLANNING_SCHEDULER_ENABLED=true
PLANNING_SCHEDULER_INTERVAL_SECONDS=60
EXTERNAL_BACKUP_LEGACY_COEXISTENCE_ENABLED=false

# Docker-era app maintenance agent (git pull + compose rebuild from the UI).
MAINTENANCE_TIMEOUT_SECONDS=300
APP_MAINTENANCE_AGENT_BASE_URL=http://host.docker.internal:8092
APP_MAINTENANCE_AGENT_HOST=127.0.0.1
APP_MAINTENANCE_AGENT_PORT=8092
APP_MAINTENANCE_AGENT_TOKEN=replace-with-random-app-maintenance-token
APP_REPO_PATH=/opt/proxmox_backup_orchestrator
APP_COMPOSE_FILE=infra/docker/docker-compose.yml
APP_MAINTENANCE_TIMEOUT_SECONDS=300
APP_MAINTENANCE_AGENT_SERVICE=proxmox-backup-orchestrator-app-maintenance-agent.service

# -----------------------------------------------------------------------------
# App VM: OPTIONAL one-time import (upgrades from a .env-configured install)
#
# Everything below is stored in the database (`users` / `app_settings`) and
# edited from the setup wizard / Settings (API: /api/v1/setup/*, /api/v1/settings).
# On the FIRST start after upgrade, values present here are copied into the
# database once; afterwards this block is ignored and can be deleted.
# A fresh install can leave it out entirely and use the setup screen.
# -----------------------------------------------------------------------------
# Legacy single account -> imported as the first administrator if no account exists.
# Generate with: py scripts/generate_password_hash.py (bcrypt: max 72 bytes).
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=$$2b$$12$$replace-with-generated-bcrypt-hash
# AUTH_TOKEN_EXPIRE_MINUTES=180

# NOTIFICATIONS_ENABLED=true
# NTFY_BASE_URL=https://ntfy.YOURDOMAINE.com
# NTFY_TOPIC=replace-with-secret-topic
# NTFY_USERNAME=pbo
# NTFY_PASSWORD=replace-with-ntfy-password
# NOTIFY_ON_BACKUP_SUCCESS=true
# NOTIFY_ON_BACKUP_FAILURE=true
# Also covers the high-priority "eject not finished, do NOT unplug" alert, which
# is sent if NOTIFY_ON_DISK_EJECT_READY or NOTIFY_ON_BACKUP_FAILURE is enabled.
# NOTIFY_ON_DISK_EJECT_READY=true
# NOTIFY_ON_UPDATE_RESULT=true
# NOTIFY_ON_AGENT_DEGRADED=true
# NOTIFY_ON_LOW_COVERAGE=true
# NOTIFY_ON_DISK_NEW_DETECTED=true
# NOTIFY_ON_DISK_KNOWN_DETECTED=true
# NOTIFY_ON_PLANNED_DISK_DETECTED=true
# NOTIFY_ON_PLANNED_BACKUP_REMINDER=true
# NOTIFY_ON_PLANNED_BACKUP_STARTED=true
# NOTIFY_ON_PLANNED_CONFIRMATION_REQUIRED=true
# NOTIFY_ON_PLANNED_BACKUP_MISSED=true
# LOW_COVERAGE_THRESHOLD_PERCENT=100
# DISK_DETECTION_NOTIFY_COOLDOWN_SECONDS=1800

# AUTO_SYNC_ENABLED=true
# PROXMOX_SYNC_INTERVAL_SECONDS=60
# PBS_SYNC_INTERVAL_SECONDS=60

# PVE_API_URL=https://proxmox.example.local:8006/api2/json
# PVE_API_TOKEN_ID=root@pam!pbo-api
# PVE_API_TOKEN_SECRET=replace-with-proxmox-api-token-secret
# PVE_VERIFY_SSL=false
# PVE_NODE_NAME=proxmox

# PBS_API_URL=https://pbs.example.local:8007/api2/json
# PBS_TOKEN_ID=root@pam!pbo-pbs
# PBS_TOKEN_SECRET=replace-with-pbs-api-token-secret
# PBS_VERIFY_SSL=false
# PBS_FINGERPRINT=
# Main/source PBS datastore: the EXACT name of the existing PBS datastore that
# external-disk exports copy FROM (`proxmox-backup-manager datastore list` on
# the PBS VM). No name is assumed. The PBS agent still reads its own copy from
# the agent .env (see below).
# PBS_DATASTORE=your-source-datastore
# How PBS is driven: api (PBS >= 3.3 REST API, removable datastores, no PBS
# agent) or agent (legacy). Default: agent when a legacy .env is imported.
# See docs/PBS_API.md before switching an existing install.
# PBS_MODE=agent

# PBS VM as seen by Proxmox for USB passthrough.
# PBS_EXECUTION_VM_ID=100
# PBS_EXECUTION_VM_NODE=proxmox

# App VM -> Proxmox host root agent.
# HOST_AGENT_BASE_URL=http://proxmox.example.local:8090
# HOST_AGENT_TOKEN=replace-with-same-token-as-proxmox-agent-AGENT_SERVER_TOKEN
# HOST_AGENT_TIMEOUT_SECONDS=7200

# App VM -> PBS VM root agent.
# PBS_AGENT_BASE_URL=http://pbs.example.local:8091
# PBS_AGENT_TOKEN=replace-with-same-token-as-pbs-agent-AGENT_SERVER_TOKEN
# PBS_AGENT_TIMEOUT_SECONDS=7200

# EXTERNAL_BACKUP_CALLBACK_BASE_URL=http://backup-orchestrator.example.local:8000/api/v1
# AGENT_STALE_AFTER_MINUTES=10

# -----------------------------------------------------------------------------
# Proxmox host agent only: /opt/proxmox-backup-orchestrator-agent/.env
# LEGACY manual install. The documented install is the one-line command shown
# by the app, which writes /etc/pbo-agent/agent.env itself, adding:
#   AGENT_CALLBACK_TOKEN   agent -> app token (distinct from AGENT_SERVER_TOKEN)
#   AGENT_API_FINGERPRINT  SHA-256 of the app certificate, pinned
#   AGENT_TLS_CERT_FILE / AGENT_TLS_KEY_FILE  the agent serves HTTPS
# Copy this block to the Proxmox host agent .env and uncomment it there.
#
# AGENT_REPO_PATH must point at a real git clone (see docs/MAINTENANCE.md) so
# `git pull --ff-only` in the maintenance flow has something to update. The
# running code stays at /opt/proxmox-backup-orchestrator-agent/{src,tests} via
# symlinks into that clone, so systemd's WorkingDirectory/.venv are untouched.
# -----------------------------------------------------------------------------
# AGENT_API_BASE_URL=http://backup-orchestrator.example.local:8000/api/v1
# AGENT_HOSTNAME=proxmox
# AGENT_VERSION=0.1.0
# AGENT_TIMEOUT_SECONDS=10
# AGENT_INCLUDE_NON_USB_CANDIDATES=false
# AGENT_EXPORT_TIMEOUT_SECONDS=7200
# AGENT_DATASTORE_CREATE_TIMEOUT_SECONDS=14400
# AGENT_SERVER_HOST=0.0.0.0
# AGENT_SERVER_PORT=8090
# AGENT_SERVER_TOKEN=replace-with-random-host-agent-token
# AGENT_REPO_PATH=/opt/proxmox-backup-orchestrator-agent-repo
# AGENT_MAINTENANCE_TIMEOUT_SECONDS=120
# AGENT_HTTP_SERVICE_NAME=proxmox-backup-orchestrator-agent-http.service
# Serve only the Proxmox-host routes (QEMU USB passthrough, spin-down, ntfy).
# AGENT_ROLE=host
# Host ntfy notification engine (Notifications page). Defaults shown; only
# override for a non-standard install. ntfy.conf (token) is never read.
# NTFY_NOTIF_TEMPLATES_PATH=/etc/ntfy-notif/templates.json
# NTFY_NOTIF_BACKUPS_DIR=/etc/ntfy-notif/backups
# NTFY_NOTIF_HISTORY_PATH=/var/log/ntfy-notif/history.jsonl
# NTFY_NOTIF_QUEUE_DIR=/var/spool/ntfy-queue
# NTFY_NOTIF_SEND_COMMAND=/usr/local/bin/ntfy-send

# -----------------------------------------------------------------------------
# PBS VM agent only: /opt/proxmox-backup-orchestrator-pbs-agent/.env
# Copy this block to the PBS agent .env and uncomment it there.
# Same AGENT_REPO_PATH / symlink convention as the host agent above.
# -----------------------------------------------------------------------------
# AGENT_API_BASE_URL=http://backup-orchestrator.example.local:8000/api/v1
# AGENT_HOSTNAME=pbs
# AGENT_VERSION=0.1.0
# AGENT_TIMEOUT_SECONDS=10
# AGENT_INCLUDE_NON_USB_CANDIDATES=false
# AGENT_EXPORT_TIMEOUT_SECONDS=7200
# AGENT_DATASTORE_CREATE_TIMEOUT_SECONDS=14400
# AGENT_SERVER_HOST=0.0.0.0
# AGENT_SERVER_PORT=8091
# AGENT_SERVER_TOKEN=replace-with-random-pbs-agent-token
# Source datastore: same value as PBS_DATASTORE on the app VM (see above).
# PBS_DATASTORE=your-source-datastore
# Max wait (seconds) for `sync -f <mount>` to flush the write cache to the USB
# disk before eject. After a large export this can take minutes. On timeout
# the eject stops WITHOUT unmounting or detaching the disk ("do NOT unplug")
# and can be retried from the Activity page. Keep it below PBS_AGENT_TIMEOUT_SECONDS.
# AGENT_EJECT_SYNC_TIMEOUT_SECONDS=1800
# AGENT_REPO_PATH=/opt/proxmox-backup-orchestrator-pbs-agent-repo
# AGENT_MAINTENANCE_TIMEOUT_SECONDS=120
# AGENT_HTTP_SERVICE_NAME=proxmox-backup-orchestrator-pbs-agent-http.service
# Serve only the PBS routes (prepare / export / eject). Not needed at all
# with PBS_MODE=api on the app side.
# AGENT_ROLE=pbs
